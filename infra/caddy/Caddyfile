# Caddyfile — HTTPS local con CA auto-firmada
# Para confiar en el certificado en dispositivos móviles:
# 1. Ejecutar: docker compose exec caddy caddy trust
# 2. Exportar CA: docker compose exec caddy cat /data/caddy/pki/authorities/local/root.crt > caddy_ca.crt
# 3. Instalar caddy_ca.crt en el dispositivo móvil

localhost {
  # Frontend
  reverse_proxy frontend:3000

  # Backend API
  handle /api/* {
    reverse_proxy backend:8080
  }

  # Headers de seguridad
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
  }

  encode gzip
  log {
    output discard
  }
}
